+const fixture = (t) => {
+  const dir = mkdtempSync(path.join(os.tmpdir(), 'ms-ci-check-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  spawnSync('git', ['init', '-b', 'main'], { cwd: dir });
+  return dir;
+};
