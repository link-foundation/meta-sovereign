 #!/usr/bin/env bash
-# check-mjs-syntax.sh
-#
-# Checks Node.js syntax for all .mjs files in src/, scripts/, and tests/.
-#
-# Usage:
-#   bash scripts/check-mjs-syntax.sh
-#
-# Exit code 0 = all files pass syntax check; non-zero = syntax error found.
