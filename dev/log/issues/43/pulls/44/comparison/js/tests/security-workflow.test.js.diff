+test('missing lychee report fails instead of claiming all links archived', (t) => {
+  const cwd = fixture(t);
+  const result = spawnSync(
+    process.execPath,
+    [
+      ...(globalThis.Deno ? ['run', '-A'] : []),
+      path.join(root, 'js/scripts/check-web-archive.mjs'),
+    ],
+    {
+      cwd,
+      encoding: 'utf8',
+      env: {
+        ...process.env,
+        LYCHEE_OUTPUT: path.join(cwd, 'missing.md'),
+        GITHUB_OUTPUT: '',
+      },
+    }
+  );
+  assert.notEqual(result.status, 0, result.stdout);
+});
+
+test('workflow policy detects mutable matrix runners and unbounded auxiliary jobs', async () => {
+  const { workflowPolicyErrors } =
+    await import('../scripts/workflow-policy.mjs');
+  const text = `permissions:\n  contents: read\njobs:\n  test:\n    runs-on: \${{ matrix.os }}\n    strategy:\n      matrix:\n        os: [ubuntu-latest]\n    steps: []\n`;
+  const errors = workflowPolicyErrors(text);
+  assert.ok(errors.some((error) => error.includes('runner')));
+  assert.ok(errors.some((error) => error.includes('timeout')));
+  assert.deepEqual(
+    workflowPolicyErrors(
+      text
+        .replace('ubuntu-latest', 'ubuntu-24.04')
+        .replace('    steps: []', '    timeout-minutes: 5\n    steps: []')
+    ),
+    []
+  );
+});
+
+test('committed dependency tree contains no deprecated registry packages', () => {
+  const lock = JSON.parse(
+    readFileSync(path.join(root, 'package-lock.json'), 'utf8')
+  );
+  const deprecated = Object.entries(lock.packages)
+    .filter(([, info]) => info.deprecated)
+    .map(([name, info]) => `${name}@${info.version}: ${info.deprecated}`);
+  assert.deepEqual(deprecated, []);
+});
+
+test('standalone shell lint selects maintained scripts without reference evidence', (t) => {
+  const cwd = fixture(t);
+  const files = [
+    'js/scripts/check.sh',
+    '.husky/pre-commit',
+    'dev/log/issues/43/pulls/44/templates/js/files/scripts/reference.sh',
+    'docs/case-studies/example/data/reference.sh',
+  ];
+  for (const file of files) {
+    mkdirSync(path.dirname(path.join(cwd, file)), { recursive: true });
+    writeFileSync(path.join(cwd, file), '#!/bin/sh\n');
+  }
+  spawnSync('git', ['add', '.'], { cwd });
+  const step = workflow('release.yml').jobs['workflow-lint'].steps.find(
+    ({ name }) => name === 'ShellCheck standalone scripts and hooks'
+  );
+  const selection = step.run.split(' | xargs')[0];
+  const result = spawnSync('bash', ['-c', selection], {
+    cwd,
+    encoding: 'utf8',
+  });
+  assert.equal(result.status, 0, result.stderr);
+  assert.deepEqual(
+    result.stdout.split('\0').filter(Boolean).sort(),
+    files.slice(0, 2).sort()
+  );
+});
