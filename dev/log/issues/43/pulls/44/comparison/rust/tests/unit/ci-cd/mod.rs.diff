+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  readFileSync,
+  readdirSync,
+  mkdtempSync,
+  mkdirSync,
+  writeFileSync,
+  rmSync,
+} from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parse } from 'yaml';
+
+const root = fileURLToPath(new URL('../../', import.meta.url));
+const workflow = (name) =>
+  parse(readFileSync(path.join(root, '.github/workflows', name), 'utf8'));
+
+test('browser failures cannot become a green release', () => {
+  const jobs = workflow('release.yml').jobs;
+  assert.ok(
+    jobs['e2e-browser'].strategy.matrix.include.some(
+      ({ browser }) => browser === 'webkit'
+    )
+  );
+  for (const step of jobs['e2e-browser'].steps) {
+    assert.notEqual(step['continue-on-error'], true);
+  }
+  assert.ok(jobs.release.needs.includes('pipeline-status'));
+});
+
+test('every Rust documentation path rejects warnings', () => {
+  const flow = workflow('release.yml');
+  let checked = 0;
+  for (const job of Object.values(flow.jobs)) {
+    for (const step of job.steps || []) {
+      if (!step.run?.includes('cargo doc ')) {
+        continue;
+      }
+      const flags =
+        step.env?.RUSTDOCFLAGS ??
+        job.env?.RUSTDOCFLAGS ??
+        flow.env?.RUSTDOCFLAGS;
+      assert.match(flags ?? '', /(?:^|\s)-D\s*warnings(?:\s|$)/);
+      checked++;
+    }
+  }
+  assert.equal(checked, 3, 'Check and both release documentation paths');
+});
+
+test('read-only jobs use supported pinned runner labels and no stored checkout credentials', () => {
+  for (const name of readdirSync(path.join(root, '.github/workflows'))) {
+    if (!name.endsWith('.yml')) {
+      continue;
+    }
+    const flow = workflow(name);
+    for (const job of Object.values(flow.jobs)) {
+      assert.doesNotMatch(String(job['runs-on']), /-latest/, name);
+      for (const step of job.steps || []) {
+        if (step.uses?.startsWith('actions/checkout@')) {
+          assert.equal(step.with?.['persist-credentials'], false, name);
+        }
+      }
+    }
+    assert.equal(flow.permissions.contents, 'read', name);
+  }
+});
+
+const fixture = (t) => {
+  const dir = mkdtempSync(path.join(os.tmpdir(), 'ms-ci-check-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  spawnSync('git', ['init', '-b', 'main'], { cwd: dir });
+  return dir;
+};
+
+test('syntax checking finds malformed nested JavaScript', (t) => {
+  const cwd = fixture(t);
+  mkdirSync(path.join(cwd, 'js/src/nested'), { recursive: true });
+  writeFileSync(path.join(cwd, 'js/src/nested/broken.js'), 'const = ;');
+  spawnSync('git', ['add', '.'], { cwd });
+  const result = spawnSync(
+    'bash',
+    [path.join(root, 'js/scripts/check-mjs-syntax.sh').replaceAll('\\', '/')],
+    { cwd, encoding: 'utf8' }
+  );
+  assert.notEqual(result.status, 0, result.stdout);
+});
+
+test('missing lychee report fails instead of claiming all links archived', (t) => {
+  const cwd = fixture(t);
+  const result = spawnSync(
+    process.execPath,
+    [
+      ...(globalThis.Deno ? ['run', '-A'] : []),
+      path.join(root, 'js/scripts/check-web-archive.mjs'),
+    ],
+    {
+      cwd,
+      encoding: 'utf8',
+      env: {
+        ...process.env,
+        LYCHEE_OUTPUT: path.join(cwd, 'missing.md'),
+        GITHUB_OUTPUT: '',
+      },
+    }
+  );
+  assert.notEqual(result.status, 0, result.stdout);
+});
+
+test('workflow policy detects mutable matrix runners and unbounded auxiliary jobs', async () => {
+  const { workflowPolicyErrors } =
+    await import('../scripts/workflow-policy.mjs');
+  const text = `permissions:\n  contents: read\njobs:\n  test:\n    runs-on: \${{ matrix.os }}\n    strategy:\n      matrix:\n        os: [ubuntu-latest]\n    steps: []\n`;
+  const errors = workflowPolicyErrors(text);
+  assert.ok(errors.some((error) => error.includes('runner')));
+  assert.ok(errors.some((error) => error.includes('timeout')));
+  assert.deepEqual(
+    workflowPolicyErrors(
+      text
+        .replace('ubuntu-latest', 'ubuntu-24.04')
+        .replace('    steps: []', '    timeout-minutes: 5\n    steps: []')
+    ),
+    []
+  );
+});
+
+test('committed dependency tree contains no deprecated registry packages', () => {
+  const lock = JSON.parse(
+    readFileSync(path.join(root, 'package-lock.json'), 'utf8')
+  );
+  const deprecated = Object.entries(lock.packages)
+    .filter(([, info]) => info.deprecated)
+    .map(([name, info]) => `${name}@${info.version}: ${info.deprecated}`);
+  assert.deepEqual(deprecated, []);
+});
+
+test('standalone shell lint selects maintained scripts without reference evidence', (t) => {
+  const cwd = fixture(t);
+  const files = [
+    'js/scripts/check.sh',
+    '.husky/pre-commit',
+    'dev/log/issues/43/pulls/44/templates/js/files/scripts/reference.sh',
+    'docs/case-studies/example/data/reference.sh',
+  ];
+  for (const file of files) {
+    mkdirSync(path.dirname(path.join(cwd, file)), { recursive: true });
+    writeFileSync(path.join(cwd, file), '#!/bin/sh\n');
+  }
+  spawnSync('git', ['add', '.'], { cwd });
+  const step = workflow('release.yml').jobs['workflow-lint'].steps.find(
+    ({ name }) => name === 'ShellCheck standalone scripts and hooks'
+  );
+  const selection = step.run.split(' | xargs')[0];
+  const result = spawnSync('bash', ['-c', selection], {
+    cwd,
+    encoding: 'utf8',
+  });
+  assert.equal(result.status, 0, result.stderr);
+  assert.deepEqual(
+    result.stdout.split('\0').filter(Boolean).sort(),
+    files.slice(0, 2).sort()
+  );
+});
