--- rust@0ece2cf2c2745c3574ffb65dbabdfcadd7163c14/scripts/check-dependency-graph.sh
+++ js/scripts/dependency-graph.mjs
@@ -1,44 +1,47 @@
-#!/usr/bin/env bash
-# Probe the comparison API before dependency-review. Transient API failures are
-# unknown, never evidence that an administrator disabled the dependency graph.
-set -euo pipefail
-[ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo "usage: $0 BASE HEAD [--require]" >&2; exit 2; }
-: "${REPO:?REPO is required}"
-base="$1"; head="$2"; required="${3:-}"
-[ -z "$required" ] || [ "$required" = --require ] || exit 2
-attempts="${DEPENDENCY_GRAPH_ATTEMPTS:-3}"
-delay="${DEPENDENCY_GRAPH_RETRY_DELAY_SECONDS:-2}"
-case "$attempts:$delay" in *[!0-9:]* | :* | *:) echo 'Invalid retry configuration' >&2; exit 2;; esac
-[ "$attempts" -gt 0 ] || exit 2
-state=unknown
-for ((attempt=1; attempt<=attempts; attempt++)); do
-  if response="$(gh api "repos/${REPO}/dependency-graph/compare/${base}...${head}" 2>&1)"; then
-    state=enabled
-    break
-  elif printf '%s' "$response" | grep -qiE 'rate.?limit|abuse|retry.after'; then
-    state=unknown
-  elif printf '%s' "$response" | grep -q '(HTTP 403)'; then
-    state=disabled
-    break
-  else
-    state=unknown
-  fi
-  echo "Dependency graph probe $attempt/$attempts was inconclusive: $response" >&2
-  if [ "$attempt" -lt "$attempts" ]; then sleep "$delay"; fi
-done
-enabled=false
-[ "$state" != enabled ] || enabled=true
-if [ -n "${GITHUB_OUTPUT:-}" ]; then
-  printf 'state=%s\nenabled=%s\n' "$state" "$enabled" >> "$GITHUB_OUTPUT"
-fi
-case "$state" in
-  enabled) echo 'Dependency graph comparison is available.';;
-  disabled)
-    message="Enable Dependency graph at https://github.com/${REPO}/settings/security_analysis so Dependency Review can run."
-    if [ "$required" = --require ]; then echo "::error::$message"; exit 1; fi
-    echo "::warning::$message Skipping Dependency Review for this pull request.";;
-  unknown)
-    message='Dependency graph availability is unknown after retries. Check GitHub API connectivity, permissions and rate limits.'
-    if [ "$required" = --require ]; then echo "::error::$message"; exit 1; fi
-    echo "::warning::$message Skipping Dependency Review for this pull request.";;
-esac
+import { appendFileSync } from 'node:fs';
+import { pathToFileURL } from 'node:url';
+
+export async function checkDependencyGraph(env = process.env, request = fetch) {
+  const repository = env.GITHUB_REPOSITORY;
+  const base = env.BASE_SHA || env.GITHUB_SHA;
+  const head = env.HEAD_SHA || env.GITHUB_SHA;
+  if (!repository || !base || !head) {
+    throw new Error('Repository and comparison SHAs are required');
+  }
+  const response = await request(
+    `https://api.github.com/repos/${repository}/dependency-graph/compare/${base}...${head}`,
+    {
+      headers: {
+        authorization: `Bearer ${env.GH_TOKEN}`,
+        accept: 'application/vnd.github+json',
+      },
+      signal: globalThis.AbortSignal.timeout(15_000),
+    }
+  );
+  if (response.ok) {
+    return true;
+  }
+  if (response.status !== 403) {
+    throw new Error(
+      `Dependency graph state is unknown: HTTP ${response.status}`
+    );
+  }
+  const message = `Dependency comparison is unavailable (HTTP 403). A repository administrator must enable Dependency graph and grant workflow access at https://github.com/${repository}/settings/security_analysis. The API does not distinguish disabled configuration from denied access.`;
+  if (env.REQUIRE_GRAPH === '1') {
+    throw new Error(message);
+  }
+  console.log(
+    `::notice::${message} PR dependency review cannot run; lockfile audits remain required.`
+  );
+  return false;
+}
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(process.argv[1]).href
+) {
+  const enabled = await checkDependencyGraph();
+  if (process.env.GITHUB_OUTPUT) {
+    appendFileSync(process.env.GITHUB_OUTPUT, `enabled=${enabled}\n`);
+  }
+}
