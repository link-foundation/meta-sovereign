+
+test('every Rust documentation path rejects warnings', () => {
+  const flow = workflow('release.yml');
+  let checked = 0;
+  for (const job of Object.values(flow.jobs)) {
+    for (const step of job.steps || []) {
+      if (!step.run?.includes('cargo doc ')) {
+        continue;
+      }
+      const flags =
+        step.env?.RUSTDOCFLAGS ??
+        job.env?.RUSTDOCFLAGS ??
+        flow.env?.RUSTDOCFLAGS;
+      assert.match(flags ?? '', /(?:^|\s)-D\s*warnings(?:\s|$)/);
+      checked++;
+    }
+  }
+  assert.equal(checked, 3, 'Check and both release documentation paths');
+});
+
+test('read-only jobs use supported pinned runner labels and no stored checkout credentials', () => {
+  for (const name of readdirSync(path.join(root, '.github/workflows'))) {
+    if (!name.endsWith('.yml')) {
+      continue;
+    }
+    const flow = workflow(name);
+    for (const job of Object.values(flow.jobs)) {
+      assert.doesNotMatch(String(job['runs-on']), /-latest/, name);
+      for (const step of job.steps || []) {
+        if (step.uses?.startsWith('actions/checkout@')) {
+          assert.equal(step.with?.['persist-credentials'], false, name);
+        }
+      }
+    }
+    assert.equal(flow.permissions.contents, 'read', name);
+  }
+});
+
+const fixture = (t) => {
+  const dir = mkdtempSync(path.join(os.tmpdir(), 'ms-ci-check-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  spawnSync('git', ['init', '-b', 'main'], { cwd: dir });
+  return dir;
+};
+
+for (const [message, expected] of [
+  ['all checks passed', 0],
+  ['SKIP: playwright not installed', 1],
+  ['SKIP: playwright is not installed', 1],
+  ['SKIP: no Playwright browser is installed', 1],
+  ['webkit not installed, skipped', 1],
+  ['SKIP: set RUN_BROWSER_E2E=1 to run', 1],
+]) {
+  test(`mandatory browser runner classifies: ${message}`, (t) => {
+    const cwd = fixture(t);
+    const scripts = path.join(cwd, 'js/scripts');
+    const helpers = path.join(cwd, 'js/tests/helpers');
+    mkdirSync(scripts, { recursive: true });
+    mkdirSync(helpers, { recursive: true });
+    writeFileSync(
+      path.join(scripts, 'run-browser-checks.mjs'),
+      readFileSync(path.join(root, 'js/scripts/run-browser-checks.mjs'))
+    );
+    writeFileSync(
+      path.join(scripts, 'browser-checks.json'),
+      JSON.stringify(['tutorial'])
+    );
+    writeFileSync(
+      path.join(helpers, 'e2e-reduced-effects.mjs'),
+      '// fixture\n'
+    );
+    writeFileSync(
+      path.join(cwd, 'package.json'),
+      JSON.stringify({ scripts: { 'test:e2e:tutorial': 'node fixture.mjs' } })
+    );
+    writeFileSync(
+      path.join(cwd, 'fixture.mjs'),
+      `console.log(${JSON.stringify(message)});\n`
+    );
+    // The CI runner is a Node entry point even when this contract runs on Deno/Bun.
+    const result = spawnSync(
+      'node',
+      [path.join(scripts, 'run-browser-checks.mjs')],
+      {
+        cwd,
+        encoding: 'utf8',
+        env: {
+          ...process.env,
+          NODE_OPTIONS: '--max-old-space-size=384',
+          E2E_ARTIFACT_DIR: path.join(cwd, 'artifacts'),
+        },
+      }
+    );
+    assert.equal(result.status, expected, result.stdout + result.stderr);
+    const summary = JSON.parse(
+      readFileSync(path.join(cwd, 'artifacts/summary.json'))
+    );
+    assert.deepEqual(summary.failures, expected ? ['tutorial'] : []);
+  });
 }
 
