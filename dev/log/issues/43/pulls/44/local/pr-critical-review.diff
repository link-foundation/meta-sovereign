           `Publish failed: ${error.message}, waiting ${RETRY_DELAY / 1000}s before retry...`
         );
-        await sleep(RETRY_DELAY);
+        await sleep(Math.min(RETRY_DELAY, Math.max(0, deadline - Date.now())));
