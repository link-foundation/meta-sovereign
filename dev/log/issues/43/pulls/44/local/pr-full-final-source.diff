diff --git a/js/tests/ci-contracts.test.js b/js/tests/ci-contracts.test.js
new file mode 100644
index 00000000..93d392fa
--- /dev/null
+++ b/js/tests/ci-contracts.test.js
@@ -0,0 +1,165 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  readFileSync,
+  readdirSync,
+  mkdtempSync,
+  mkdirSync,
+  writeFileSync,
+  rmSync,
+} from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parse } from 'yaml';
+
+const root = fileURLToPath(new URL('../../', import.meta.url));
+const workflow = (name) =>
+  parse(readFileSync(path.join(root, '.github/workflows', name), 'utf8'));
+
+test('browser failures cannot become a green release', () => {
+  const jobs = workflow('release.yml').jobs;
+  assert.ok(
+    jobs['e2e-browser'].strategy.matrix.include.some(
+      ({ browser }) => browser === 'webkit'
+    )
+  );
+  for (const step of jobs['e2e-browser'].steps) {
+    assert.notEqual(step['continue-on-error'], true);
+  }
+  assert.ok(jobs.release.needs.includes('pipeline-status'));
+});
+
+test('every Rust documentation path rejects warnings', () => {
+  const flow = workflow('release.yml');
+  let checked = 0;
+  for (const job of Object.values(flow.jobs)) {
+    for (const step of job.steps || []) {
+      if (!step.run?.includes('cargo doc ')) {
+        continue;
+      }
+      const flags =
+        step.env?.RUSTDOCFLAGS ??
+        job.env?.RUSTDOCFLAGS ??
+        flow.env?.RUSTDOCFLAGS;
+      assert.match(flags ?? '', /(?:^|\s)-D\s*warnings(?:\s|$)/);
+      checked++;
+    }
+  }
+  assert.equal(checked, 3, 'Check and both release documentation paths');
+});
+
+test('read-only jobs use supported pinned runner labels and no stored checkout credentials', () => {
+  for (const name of readdirSync(path.join(root, '.github/workflows'))) {
+    if (!name.endsWith('.yml')) {
+      continue;
+    }
+    const flow = workflow(name);
+    for (const job of Object.values(flow.jobs)) {
+      assert.doesNotMatch(String(job['runs-on']), /-latest/, name);
+      for (const step of job.steps || []) {
+        if (step.uses?.startsWith('actions/checkout@')) {
+          assert.equal(step.with?.['persist-credentials'], false, name);
+        }
+      }
+    }
+    assert.equal(flow.permissions.contents, 'read', name);
+  }
+});
+
+const fixture = (t) => {
+  const dir = mkdtempSync(path.join(os.tmpdir(), 'ms-ci-check-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  spawnSync('git', ['init', '-b', 'main'], { cwd: dir });
+  return dir;
+};
+
+test('syntax checking finds malformed nested JavaScript', (t) => {
+  const cwd = fixture(t);
+  mkdirSync(path.join(cwd, 'js/src/nested'), { recursive: true });
+  writeFileSync(path.join(cwd, 'js/src/nested/broken.js'), 'const = ;');
+  spawnSync('git', ['add', '.'], { cwd });
+  const result = spawnSync(
+    'bash',
+    [path.join(root, 'js/scripts/check-mjs-syntax.sh').replaceAll('\\', '/')],
+    { cwd, encoding: 'utf8' }
+  );
+  assert.notEqual(result.status, 0, result.stdout);
+});
+
+test('missing lychee report fails instead of claiming all links archived', (t) => {
+  const cwd = fixture(t);
+  const result = spawnSync(
+    process.execPath,
+    [
+      ...(globalThis.Deno ? ['run', '-A'] : []),
+      path.join(root, 'js/scripts/check-web-archive.mjs'),
+    ],
+    {
+      cwd,
+      encoding: 'utf8',
+      env: {
+        ...process.env,
+        LYCHEE_OUTPUT: path.join(cwd, 'missing.md'),
+        GITHUB_OUTPUT: '',
+      },
+    }
+  );
+  assert.notEqual(result.status, 0, result.stdout);
+});
+
+test('workflow policy detects mutable matrix runners and unbounded auxiliary jobs', async () => {
+  const { workflowPolicyErrors } =
+    await import('../scripts/workflow-policy.mjs');
+  const text = `permissions:\n  contents: read\njobs:\n  test:\n    runs-on: \${{ matrix.os }}\n    strategy:\n      matrix:\n        os: [ubuntu-latest]\n    steps: []\n`;
+  const errors = workflowPolicyErrors(text);
+  assert.ok(errors.some((error) => error.includes('runner')));
+  assert.ok(errors.some((error) => error.includes('timeout')));
+  assert.deepEqual(
+    workflowPolicyErrors(
+      text
+        .replace('ubuntu-latest', 'ubuntu-24.04')
+        .replace('    steps: []', '    timeout-minutes: 5\n    steps: []')
+    ),
+    []
+  );
+});
+
+test('committed dependency tree contains no deprecated registry packages', () => {
+  const lock = JSON.parse(
+    readFileSync(path.join(root, 'package-lock.json'), 'utf8')
+  );
+  const deprecated = Object.entries(lock.packages)
+    .filter(([, info]) => info.deprecated)
+    .map(([name, info]) => `${name}@${info.version}: ${info.deprecated}`);
+  assert.deepEqual(deprecated, []);
+});
+
+test('standalone shell lint selects maintained scripts without reference evidence', (t) => {
+  const cwd = fixture(t);
+  const files = [
+    'js/scripts/check.sh',
+    '.husky/pre-commit',
+    'dev/log/issues/43/pulls/44/templates/js/files/scripts/reference.sh',
+    'docs/case-studies/example/data/reference.sh',
+  ];
+  for (const file of files) {
+    mkdirSync(path.dirname(path.join(cwd, file)), { recursive: true });
+    writeFileSync(path.join(cwd, file), '#!/bin/sh\n');
+  }
+  spawnSync('git', ['add', '.'], { cwd });
+  const step = workflow('release.yml').jobs['workflow-lint'].steps.find(
+    ({ name }) => name === 'ShellCheck standalone scripts and hooks'
+  );
+  const selection = step.run.split(' | xargs')[0];
+  const result = spawnSync('bash', ['-c', selection], {
+    cwd,
+    encoding: 'utf8',
+  });
+  assert.equal(result.status, 0, result.stderr);
+  assert.deepEqual(
+    result.stdout.split('\0').filter(Boolean).sort(),
+    files.slice(0, 2).sort()
+  );
+});
diff --git a/js/tests/ci-detection.test.js b/js/tests/ci-detection.test.js
new file mode 100644
index 00000000..ba68db13
--- /dev/null
+++ b/js/tests/ci-detection.test.js
@@ -0,0 +1,112 @@
+// Real temporary git histories reproduce CI selection; no GitHub/network calls.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const script = fileURLToPath(
+  new URL('../scripts/detect-code-changes.mjs', import.meta.url)
+);
+const fixture = (t) => {
+  const cwd = mkdtempSync(path.join(os.tmpdir(), 'ms-ci-diff-'));
+  t.after(() => rmSync(cwd, { recursive: true, force: true }));
+  const git = (...args) =>
+    execFileSync('git', args, {
+      cwd,
+      encoding: 'utf8',
+      stdio: ['ignore', 'pipe', 'pipe'],
+    }).trim();
+  git('init', '-b', 'main');
+  git('config', 'user.name', 'CI fixture');
+  git('config', 'user.email', 'fixture@example.test');
+  const commit = (file) => {
+    mkdirSync(path.dirname(path.join(cwd, file)), { recursive: true });
+    writeFileSync(path.join(cwd, file), `${file}\n`);
+    git('add', '.');
+    git('commit', '-m', file);
+    return git('rev-parse', 'HEAD');
+  };
+  const run = (env = {}) =>
+    spawnSync(
+      process.execPath,
+      globalThis.Deno ? ['run', '-A', script] : [script],
+      {
+        cwd,
+        encoding: 'utf8',
+        env: {
+          ...process.env,
+          GITHUB_OUTPUT: '',
+          GITHUB_EVENT_PATH: '',
+          GITHUB_EVENT_NAME: '',
+          GITHUB_BASE_SHA: '',
+          GITHUB_HEAD_SHA: '',
+          GITHUB_SHA: '',
+          ...env,
+        },
+      }
+    );
+  return { cwd, git, commit, run };
+};
+
+test('PR checks include earlier code after a docs-only follow-up', (t) => {
+  const { git, commit, run } = fixture(t);
+  const base = commit('README.md');
+  git('checkout', '-b', 'feature');
+  commit('js/src/changed.js');
+  const head = commit('docs/follow-up.md');
+  git('checkout', 'main');
+  git('merge', '--no-ff', 'feature', '-m', 'synthetic merge');
+  const result = run({
+    GITHUB_EVENT_NAME: 'pull_request',
+    GITHUB_BASE_SHA: base,
+    GITHUB_HEAD_SHA: head,
+  });
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /js-changed=true/);
+  assert.match(result.stdout, /any-code-changed=true/);
+});
+
+test('multi-commit push checks the whole event range', (t) => {
+  const { cwd, commit, run } = fixture(t);
+  const before = commit('README.md');
+  commit('rust/crates/core/src/lib.rs');
+  const after = commit('docs/follow-up.md');
+  const event = path.join(cwd, 'event.json');
+  writeFileSync(event, JSON.stringify({ before, after }));
+  const result = run({ GITHUB_EVENT_NAME: 'push', GITHUB_EVENT_PATH: event });
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /rust-changed=true/);
+  assert.match(result.stdout, /any-code-changed=true/);
+});
+
+test('initial commit is checked instead of silently returning no changes', (t) => {
+  const { commit, run } = fixture(t);
+  commit('js/src/initial.js');
+  const result = run();
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /js-changed=true/);
+});
+
+test('evidence snapshots never count as executable code changes', (t) => {
+  const { commit, run } = fixture(t);
+  commit('README.md');
+  commit('dev/log/issues/43/pulls/44/templates/source.mjs');
+  const result = run();
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /mjs-changed=false/);
+  assert.match(result.stdout, /any-code-changed=false/);
+});
+
+test('unavailable explicit PR revisions fail closed', (t) => {
+  const { commit, run } = fixture(t);
+  const head = commit('README.md');
+  const result = run({
+    GITHUB_EVENT_NAME: 'pull_request',
+    GITHUB_BASE_SHA: 'f'.repeat(40),
+    GITHUB_HEAD_SHA: head,
+  });
+  assert.notEqual(result.status, 0);
+});
diff --git a/js/tests/ci-helpers.test.js b/js/tests/ci-helpers.test.js
new file mode 100644
index 00000000..9d1a06ae
--- /dev/null
+++ b/js/tests/ci-helpers.test.js
@@ -0,0 +1,231 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  resolveNamedExport,
+  loadCommandStream,
+} from '../scripts/use-module.mjs';
+import { pipelineFailures } from '../scripts/check-pipeline-status.mjs';
+import { npmVersionState } from '../scripts/registry-state.mjs';
+import { waitForServer } from './helpers/pack-process.mjs';
+
+test('release dependencies normalize ESM and nested CommonJS and reject unsupported shapes', async () => {
+  const value = {
+    $: () => {},
+    shell: { errexit: (value) => assert.equal(value, true) },
+  };
+  for (const shape of [
+    value,
+    { default: value },
+    { 'module.exports': value },
+    { default: { default: value } },
+  ]) {
+    assert.equal(resolveNamedExport(shape, '$', 'fixture'), value);
+  }
+  assert.throws(
+    () => resolveNamedExport({ default: {} }, '$', 'fixture'),
+    /callable/
