hanged: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: node js/scripts/detect-code-changes.mjs\n\n  release-preflight:\n    name: Release credential preflight\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    outputs:\n      graph-enabled: ${{ steps.graph.outputs.enabled }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          package-manager-cache: false\n      - name: Check dependency review capability before building\n        id: graph\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n          BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.before || github.sha }}\n          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          REQUIRE_GRAPH: ${{ github.ref == 'refs/heads/main' && github.event_name != 'pull_request' && '1' || '0' }}\n        run: node js/scripts/dependency-graph.mjs\n      - name: Verify npm trusted publisher before building\n        id: npm\n        continue-on-error: true\n        env:\n          PREFLIGHT_MODE: ${{ github.ref == 'refs/heads/main' && (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.release_mode == 'instant')) && 'release' || 'report' }}\n        run: node js/scripts/preflight-release.mjs\n\n      - name: Require every release prerequisite\n        if: ${{ !cancelled() }}\n        env:\n          GRAPH_OUTCOME: ${{ steps.graph.outcome }}\n          NPM_OUTCOME: ${{ steps.npm.outcome }}\n        run: |\n          if [ \"$GRAPH_OUTCOME\" != success ] || [ \"$NPM_OUTCOME\" != success ]; then\n            echo \"::error::Release preflight failed. Review every prerequisite above; administrator setup is required before a main release can build.\"\n            exit 1\n          fi\n\n  # === FAST CHECKS - run before slow tests for fastest feedback ===\n  # See: hive-mind CI/CD best practices principle #5 (fast-fail job ordering)\n\n  # Syntax check all .mjs files with node --check (~7s)\n  test-compilation:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test-compilation-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Test Compilation\n    runs-on: ubuntu-24.04\n    # Typical run: ~4s. Tight cap fails fast on accidental infinite loops.\n    timeout-minutes: 5\n    needs: [detect-changes, release-preflight]\n    if: |\n      github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.mjs-changed == 'true' ||\n      needs.detect-changes.outputs.js-changed == 'true' ||\n      needs.detect-changes.outputs.workflow-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Check .mjs syntax\n        run: bash js/scripts/check-mjs-syntax.sh\n\n  # Enforce 1500-line limit on .mjs files and release.yml\n  check-file-line-limits:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-check-file-line-limits-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Check File Line Limits\n    runs-on: ubuntu-24.04\n    # Typical run: ~3s. Just walks the tree counting lines.\n    timeout-minutes: 5\n    needs: [detect-changes, release-preflight]\n    if: |\n      github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.mjs-changed == 'true' ||\n      needs.detect-changes.outputs.js-changed == 'true' ||\n      needs.detect-changes.outputs.workflow-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash js/scripts/simulate-fresh-merge.sh\n\n      - name: Check file line limits\n        run: bash js/scripts/check-file-line-limits.sh\n\n  # === VERSION CHANGE CHECK ===\n  # Prohibit manual version changes in package.json - versions should only be changed by CI/CD\n  version-check:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-version-check-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Check for Manual Version Changes\n    runs-on: ubuntu-24.04\n    # Typical run: ~6s. Read-only diff inspection.\n    timeout-minutes: 5\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Check for version changes in package.json\n        env:\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: node js/scripts/check-version.mjs\n\n  # === CHANGESET CHECK - only runs on PRs with code changes ===\n  # Docs-only PRs (./docs folder, markdown files) don't require changesets\n  changeset-check:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-changeset-check-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Check for Changesets\n    runs-on: ubuntu-24.04\n    # Typical run: ~13s including npm install. 10min covers cold cache.\n    timeout-minutes: 10\n    needs: [detect-changes, release-preflight]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Check for changesets\n        env:\n          # Pass PR context to the validation script\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          PR_HEAD_REF: ${{ github.head_ref }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: |\n          # Skip changeset check for automated version PRs\n          if [[ \"$PR_HEAD_REF\" == \"changeset-release/\"* ]]; then\n            echo \"Skipping changeset check for automated release PR\"\n            exit 0\n          fi\n\n          # Run changeset validation script\n          # This validates that exactly ONE changeset was ADDED by this PR\n          # Pre-existing changesets from other merged PRs are ignored\n          node js/scripts/validate-changeset.mjs\n\n  # === LINT AND FORMAT CHECK ===\n  # Lint runs independently of changeset-check - it's a fast check that should always run\n  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n  # IMPORTANT: ESLint includes max-lines rule (1500 lines) to ensure files stay maintainable\n  # See docs/case-studies/issue-23 for why fresh merge simulation is critical\n  lint:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-lint-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Lint and Format Check\n    runs-on: ubuntu-24.04\n    # Typical run: ~23s including npm install + ESLint + Prettier + jscpd\n    # + secretlint. 10min cap protects against a hung lint plugin.\n    timeout-minutes: 10\n    needs: [detect-changes, release-preflight]\n    if: |\n      github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.mjs-changed == 'true' ||\n      needs.detect-changes.outputs.js-changed == 'true' ||\n      needs.detect-changes.outputs.docs-changed == 'true' ||\n      needs.detect-changes.outputs.package-changed == 'true' ||\n      needs.detect-changes.outputs.workflow-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          # For PRs, fetch enough history to merge with base branch\n          fetch-depth: 0\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash js/scripts/simulate-fresh-merge.sh\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Run ESLint\n        run: npm run lint\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check code duplication\n        run: npm run check:duplication\n\n      - name: Check for secrets\n        run: npx --no-install secretlint \"**/*\"\n\n  # Test matrix: 3 runtimes (Node.js, Bun, Deno) x 3 OS (Ubuntu, macOS, Windows)\n  # IMPORTANT: Tests must validate the ACTUAL merge result, not a stale merge preview.\n  # See docs/case-studies/issue-23 for why this is critical.\n  # Fast-fail: slow test matrix only runs after fast checks pass (hive-mind principle #5)\n  test:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Test (${{ matrix.runtime }} on ${{ matrix.os }})\n    runs-on: ${{ matrix.runner || matrix.os }}\n    # Typical run: 13–55s (deno on Windows can spike to ~2min on cold runners).\n    # 10min cap surfaces a hung test or flaky network well before the\n    # 6h GitHub default — the user wants flaky tests to fail fast.\n    timeout-minutes: 10\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        changeset-check,\n        test-compilation,\n        lint,\n        check-file-line-limits,\n        version-check,\n        workflow-lint,\n      ]\n    # Use !cancelled() instead of always() so cancellation propagates correctly (hive-mind issue #1278)\n    # Run if: push event, OR changeset-check succeeded, OR changeset-check was skipped (docs-only PR)\n    # AND all fast checks passed (or were skipped for irrelevant changes)\n    if: |-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (!cancelled() && needs.detect-changes.result == 'success' &&\n      (needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch') &&\n      (github.event_name == 'push' || needs.changeset-check.result == 'success' || needs.changeset-check.result == 'skipped') &&\n      (needs.test-compilation.result == 'success' || needs.test-compilation.result == 'skipped') &&\n      (needs.lint.result == 'success' || needs.lint.result == 'skipped') &&\n      (needs.check-file-line-limits.result == 'success' || needs.check-file-line-limits.result == 'skipped'))\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-15, windows-2025]\n        runtime: [node, bun, deno]\n        # Retain all nine runtime/OS targets. Use the separate native Intel\n        # pool for Node after repeated hosted ARM runner allocation failures;\n        # Bun/Deno and desktop packaging still cover macOS ARM.\n        include:\n          - os: macos-15\n            runtime: node\n            runner: macos-15-intel\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          # For PRs, fetch enough history to merge with base branch\n          fetch-depth: 0\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        shell: bash\n        run: bash js/scripts/simulate-fresh-merge.sh\n\n      - name: Setup Node.js\n        if: matrix.runtime == 'node'\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies (Node.js)\n        if: matrix.runtime == 'node'\n        run: npm ci --no-audit --no-fund\n\n      - name: Run tests (Node.js)\n        if: matrix.runtime == 'node'\n        run: node --test --test-concurrency=2 --test-timeout=30000 js/tests/*.test.js\n\n      - name: Setup Bun\n        if: matrix.runtime == 'bun'\n        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\n        with:\n          bun-version: latest\n\n      - name: Install dependencies (Bun)\n        if: matrix.runtime == 'bun'\n        run: bun install\n\n      - name: Run tests (Bun)\n        if: matrix.runtime == 'bun'\n        # --timeout caps an individual test at 30s. Default is 5s but a few\n        # WebRTC / WebSocket scenarios run slower on cold runners; 30s leaves\n        # headroom while still failing fast on a hung promise.\n        run: bun test --timeout 30000\n\n      - name: Setup Deno\n        if: matrix.runtime == 'deno'\n        uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2\n        with:\n          deno-version: v2.x\n\n      - name: Install reviewed native dependency scripts (Deno)\n        if: matrix.runtime == 'deno'\n        run: deno install\n\n      - name: Run tests (Deno)\n        if: matrix.runtime == 'deno'\n        shell: bash\n        # Deno requires --allow-all for private Windows named pipes. Tests\n        # remain isolated in fixture stores and never use personal accounts.\n        env:\n          CI_CRYPTO_DIAGNOSTICS: ${{ runner.os == 'Windows' && '1' || '0' }}\n          RUST_BACKTRACE: '1'\n        run: |\n          if [ \"$RUNNER_OS\" = Windows ]; then node experiments/issue43-cifrante.mjs; fi\n          deno test --allow-all js/tests\n\n  # === RUST CRATES (R-Z6) ===\n  # fmt, clippy (warnings are errors) and the crates' own tests, so the\n  # Rust port can not rot unseen. Required by the terminal release gate.\n  rust:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-rust-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Rust (fmt, clippy, test)\n    runs-on: ubuntu-24.04\n    # Cold build ~4min, cached ~1min.\n    timeout-minutes: 20\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        check-file-line-limits,\n        test-compilation,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: >-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (!cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (github.event_name == 'workflow_dispatch' || needs.detect-changes.outputs.rust-changed == 'true' || needs.detect-changes.outputs.workflow-changed == 'true'))\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust toolchain\n        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n        with:\n          components: rustfmt, clippy\n\n      - name: Cache cargo\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: cargo-${{ runner.os }}-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: cargo-${{ runner.os }}-\n\n      - name: cargo fmt --check\n        run: cargo fmt --manifest-path rust/Cargo.toml --all -- --check\n\n      - name: cargo clippy\n        run: cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings\n\n      - name: cargo test\n        run: cargo test --manifest-path rust/Cargo.toml --workspace\n\n  # === BROWSER E2E (R-Z6) ===\n  # A representative set of the `test:e2e:*` scripts in chromium: the SPA\n  # smoke test, the chat basics, rich and service messages, ephemeral\n  # messages, accounts and data export, offline, the passcode, rich text,\n  # Instant View, email, greetings, autopilot, the peer bar and the tutorial.\n  # Each script prints OK or fails; all run, then the job reports every\n  # failure at once; both engines are release gates.\n  e2e-browser:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-e2e-browser-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Browser e2e (${{ matrix.browser }})\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 35\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        test-compilation,\n        check-file-line-limits,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: >-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (!cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (needs.detect-changes.outputs.any-code-changed == 'true' || needs.detect-changes.outputs.workflow-changed == 'true'))\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - browser: chromium\n            runner: ubuntu-24.04\n          - browser: webkit\n            runner: macos-15-intel\n    env:\n      RUN_BROWSER_E2E: '1'\n      E2E_BROWSER: ${{ matrix.browser }}\n      E2E_ENGINES: ${{ matrix.browser }}\n      E2E_SAFARI: '0'\n      E2E_ARTIFACT_DIR: artifacts/browser\n      CI_TUTORIAL_DEBUG: '1'\n      DEBUG: ${{ vars.CI_BROWSER_DEBUG == '1' && 'pw:api' || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n      - name: Test the fresh merge\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash js/scripts/simulate-fresh-merge.sh\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          cache: npm\n      - run: npm ci --no-audit --no-fund\n      - name: Install the browser\n        env:\n          BROWSER: ${{ matrix.browser }}\n        run: npx playwright install --with-deps \"$BROWSER\"\n      - run: npm run build:web\n      - name: Run browser checks\n        id: browser-checks\n        run: node js/scripts/run-browser-checks.mjs\n      - name: Preserve browser diagnostics\n        if: ${{ !cancelled() && steps.browser-checks.outcome != 'skipped' && steps.browser-checks.outcome != '' }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: browser-${{ matrix.browser }}\n          path: artifacts/browser/\n          if-no-files-found: error\n          retention-days: 14\n\n  # === API DOCUMENTATION BUILD ===\n  # Build JS API docs (`npm run docs:api`) and Rust crate docs\n  # (`cargo doc --manifest-path rust/Cargo.toml --no-deps`) on every push and PR. This catches doc-comment\n  # errors before release and produces artefacts the `release` job attaches\n  # to GitHub Releases (R-H3).\n  docs-build:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-docs-build-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Build API Docs\n    runs-on: ubuntu-24.04\n    # Typical run: ~25s. cargo doc dominates and is well-bounded.\n    timeout-minutes: 15\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        test-compilation,\n        check-file-line-limits,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: |-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.mjs-changed == 'true' ||\n      needs.detect-changes.outputs.js-changed == 'true' ||\n      needs.detect-changes.outputs.docs-changed == 'true' ||\n      needs.detect-changes.outputs.rust-changed == 'true' ||\n      needs.detect-changes.outputs.workflow-changed == 'true')\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Build JS API docs\n        run: npm run docs:api\n\n      - name: Setup Rust toolchain\n        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n\n      - name: Build Rust crate docs\n        run: cargo doc --manifest-path rust/Cargo.toml --no-deps --workspace\n\n      - name: Upload JS API docs artifact\n        uses: actions/upload-artifact@v7\n        with:\n          name: docs-api-js\n          path: docs/api/\n          if-no-files-found: error\n          retention-days: 30\n\n      - name: Upload Rust crate docs artifact\n        uses: actions/upload-artifact@v7\n        with:\n          name: docs-api-rust\n          path: rust/target/doc/\n          if-no-files-found: error\n          retention-days: 30\n\n  # === DOCUMENTATION VALIDATION ===\n  # Validate documentation files when docs change (hive-mind principle #12)\n  validate-docs:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-validate-docs-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Validate Documentation\n    runs-on: ubuntu-24.04\n    # Typical run: <5s. Pure shell file walk.\n    timeout-minutes: 5\n    needs: [detect-changes, release-preflight]\n    if: |\n      github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.docs-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Check documentation file sizes\n        run: |\n          LIMIT=2500\n          FAILURES=()\n\n          echo \"Checking that documentation files are under ${LIMIT} lines...\"\n\n          while IFS= read -r -d '' file; do\n            line_count=$(wc -l < \"$file\")\n            if [ \"$line_count\" -gt \"$LIMIT\" ]; then\n              echo \"ERROR: $file has $line_count lines (limit: ${LIMIT})\"\n              echo \"::error file=$file::Documentation file has $line_count lines (limit: ${LIMIT})\"\n              FAILURES+=(\"$file\")\n            fi\n          done < <(find docs -name \"*.md\" -type f -print0 2>/dev/null)\n\n          if [ \"${#FAILURES[@]}\" -gt 0 ]; then\n            echo \"The following docs exceed the ${LIMIT} line limit:\"\n            printf '  %s\\n' \"${FAILURES[@]}\"\n            exit 1\n          else\n            echo \"All documentation files are within the ${LIMIT} line limit.\"\n          fi\n\n      - name: Check required documentation files exist\n        run: |\n          REQUIRED_FILES=(\n            \"docs/BEST-PRACTICES.md\"\n            \"docs/CONTRIBUTING.md\"\n            \"docs/ROADMAP.md\"\n            \"docs/REQUIREMENTS.md\"\n            \"README.md\"\n            \"CHANGELOG.md\"\n          )\n\n          MISSING=()\n          for file in \"${REQUIRED_FILES[@]}\"; do\n            if [ ! -f \"$file\" ]; then\n              echo \"ERROR: Required documentation file missing: $file\"\n              MISSING+=(\"$file\")\n            else\n              echo \"Found: $file\"\n            fi\n          done\n\n          if [ \"${#MISSING[@]}\" -gt 0 ]; then\n            echo \"\"\n            echo \"Missing required documentation files:\"\n            printf '  %s\\n' \"${MISSING[@]}\"\n            exit 1\n          else\n            echo \"All required documentation files present.\"\n          fi\n\n  # The package as npm would ship it, without publishing: `npm pack`\n  # builds the tarball `npm publish` uploads, npx runs it, and the\n  # server must default to Pages and expose its local HTTPS API\n  # (js/tests/pack-smoke.mjs).\n  package:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-package-${{ strategy.job-index || 0 }}\n      cancel-in-progress: true\n    name: Package (packed and run with npx)\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        test-compilation,\n        check-file-line-limits,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: |-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (github.event_name == 'workflow_dispatch' ||\n      needs.detect-changes.outputs.any-code-changed == 'true' ||\n      needs.detect-changes.outputs.package-changed == 'true')\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      # npm pack lists the same files without asking the registry, which\n      # refuses a dry-run publish of a version that is already released.\n      - name: What npm publish would upload\n        run: npm pack --dry-run --ignore-scripts\n\n      - name: Run the packed package with npx\n        env:\n          PACK_SMOKE_ARTIFACT_DIR: artifacts/pack\n          CI_SCRIPTS_DEBUG: ${{ vars.CI_SCRIPTS_DEBUG }}\n        run: npm run test:pack\n\n      - name: Preserve package diagnostics\n        if: ${{ !cancelled() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: package-diagnostics\n          path: artifacts/pack/\n          if-no-files-found: error\n\n  backup-memory:\n    name: Backup memory regression (200k links)\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        test-compilation,\n        check-file-line-limits,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: >-\n      !cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (!cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch'))\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n      - run: npm ci --no-audit --no-fund\n      - name: Verify streaming memory bound and complete round trip\n        env:\n          RUN_BACKUP_STRESS: '1'\n        run: node --max-old-space-size=384 --test --test-name-pattern='200k-link' js/tests/backup-stream.test.js\n\n  workflow-lint:\n    name: Workflow, shell and pipeline contracts\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    needs: [detect-changes, release-preflight]\n    if: needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n      - run: npm ci --no-audit --no-fund\n      - name: actionlint, ShellCheck and pyflakes\n        run: docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color\n      - name: ShellCheck standalone scripts and hooks\n        run: git ls-files -z -- '*.sh' '.husky/*' ':(exclude)dev/log/**' ':(exclude)docs/case-studies/**' | xargs -0 docker run --rm -v \"$PWD:/repo\" -w /repo --entrypoint shellcheck rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 --shell=bash\n      - name: Install pinned workflow security scanner\n        run: pipx install zizmor==1.30.1\n      - name: Workflow security audit (offline deterministic policy)\n        run: zizmor --offline --format plain .github/workflows\n      - name: Check pipeline gate and browser coverage\n        run: node js/scripts/check-ci-workflows.mjs\n      - run: node --test --test-concurrency=1 js/tests/ci-*.test.js\n\n  dependency-audit:\n    name: Dependency security audit\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    needs: [detect-changes, release-preflight]\n    if: needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          package-manager-cache: false\n      - run: npm ci --no-audit --no-fund\n      - run: npm audit --package-lock-only --audit-level=low\n      - uses: taiki-e/install-action@e67fa11c4b9316fa714ddf0abed07a0c3143b95b # v2.87.4\n        with:\n          tool: cargo-audit@0.22.2\n      - run: cargo audit --file rust/Cargo.lock --deny warnings\n\n  codeql:\n    name: CodeQL (${{ matrix.language }})\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        lint,\n        test-compilation,\n        check-file-line-limits,\n        changeset-check,\n        version-check,\n        workflow-lint,\n      ]\n    if: \"!cancelled() && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && (needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch')\"\n    permissions:\n      actions: read\n      contents: read\n      security-events: write\n    strategy:\n      fail-fast: false\n      matrix:\n        language: [javascript-typescript, python, rust, actions]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: github/codeql-action/init@v4\n        with:\n          languages: ${{ matrix.language }}\n          build-mode: none\n          config-file: ./.github/codeql/codeql-config.yml\n      - uses: github/codeql-action/analyze@v4\n\n  dependency-review:\n    name: Review dependency changes\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    needs: [detect-changes, release-preflight]\n    if: github.event_name == 'pull_request' && needs.release-preflight.outputs.graph-enabled == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/dependency-review-action@v5\n        with:\n          fail-on-severity: low\n          comment-summary-in-pr: never\n\n  pipeline-status:\n    name: Pipeline status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    if: ${{ !cancelled() }}\n    needs:\n      [\n        detect-changes,\n        release-preflight,\n        test-compilation,\n        check-file-line-limits,\n        version-check,\n        changeset-check,\n        lint,\n        test,\n        rust,\n        e2e-browser,\n        docs-build,\n        validate-docs,\n        package,\n        backup-memory,\n        workflow-lint,\n        dependency-audit,\n        dependency-review,\n        codeql,\n      ]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n      - name: Require every selected check to pass\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n        run: node js/scripts/check-pipeline-status.mjs\n\n  # Release - only runs on main after tests pass (for push events)\n  release:\n    concurrency:\n      group: release-main\n      cancel-in-progress: false\n    name: Release\n    # Cap publish work (changeset merge, version commit, npm publish,\n    # GitHub release, doc upload). Typical run is well under 10min;\n    # 30min covers npm registry retries on a bad day.\n    timeout-minutes: 30\n    needs: [pipeline-status, release-preflight]\n    if: >-\n      !cancelled() && github.ref == 'refs/heads/main' && github.event_name == 'push' && needs.pipeline-status.result == 'success'\n    runs-on: ubuntu-24.04\n    # Permissions required for npm OIDC trusted publishing\n    permissions:\n      contents: write\n      id-token: write\n    env:\n      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Configure release git authentication\n        run: gh auth setup-git\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          package-manager-cache: false\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Update npm for OIDC trusted publishing\n        run: node js/scripts/setup-npm.mjs\n\n      - name: Check for changesets\n        id: check_changesets\n        run: node js/scripts/check-changesets.mjs\n\n      - name: Check if release is needed\n        id: check_release\n        env:\n          HAS_CHANGESETS: ${{ steps.check_changesets.outputs.has_changesets }}\n        run: node js/scripts/check-release-needed.mjs\n\n      - name: Merge multiple changesets\n        if: steps.check_changesets.outputs.has_changesets == 'true' && steps.check_changesets.outputs.changeset_count > 1\n        run: |\n          echo \"Multiple changesets detected, merging...\"\n          node js/scripts/merge-changesets.mjs\n\n      - name: Version packages and commit to main\n        if: steps.check_changesets.outputs.has_changesets == 'true'\n        id: version\n        run: node js/scripts/version-and-commit.mjs --mode changeset\n\n      - name: Publish to npm\n        # Run if version was committed, if a previous attempt already committed (for re-runs),\n        # or if check-release-needed detected an unpublished version (self-healing, issue #36)\n        if: >-\n          steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true' || (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        id: publish\n        run: node js/scripts/publish-to-npm.mjs\n\n      - name: Create GitHub Release\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          VERSION: ${{ steps.publish.outputs.published_version || steps.check_release.outputs.current_version }}\n          REPOSITORY: ${{ github.repository }}\n          TARGET_COMMITISH: HEAD\n          COMMIT_SHA: HEAD\n        run: node js/scripts/create-github-release.mjs\n\n      - name: Format GitHub release notes\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          VERSION: ${{ steps.publish.outputs.published_version || steps.check_release.outputs.current_version }}\n          REPOSITORY: ${{ github.repository }}\n          TARGET_COMMITISH: HEAD\n          COMMIT_SHA: HEAD\n        run: node js/scripts/format-github-release.mjs\n\n      - name: Build JS API docs for release\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        run: npm run docs:api\n\n      - name: Setup Rust toolchain for release docs\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n\n      - name: Build Rust crate docs for release\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        run: cargo doc --manifest-path rust/Cargo.toml --no-deps --workspace\n\n      - name: Attach API docs to GitHub Release\n        if: steps.publish.outputs.published == 'true' || steps.check_release.outputs.github_release_missing == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_TAG: v${{ steps.publish.outputs.published_version || steps.check_release.outputs.current_version }}\n        run: bash js/scripts/attach-api-docs.sh \"$RELEASE_TAG\"\n\n  # Manual Instant Release - triggered via workflow_dispatch with instant mode\n  # This job is in release.yml because npm trusted publishing\n  # only allows one workflow file to be registered as a trusted publisher\n  instant-release:\n    concurrency:\n      group: release-main\n      cancel-in-progress: false\n    name: Instant Release\n    needs: [pipeline-status, release-preflight]\n    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' && github.event.inputs.release_mode == 'instant'\n    runs-on: ubuntu-24.04\n    # Same envelope as the automated release path.\n    timeout-minutes: 30\n    # Permissions required for npm OIDC trusted publishing\n    permissions:\n      contents: write\n      id-token: write\n    env:\n      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Configure release git authentication\n        run: gh auth setup-git\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          package-manager-cache: false\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Update npm for OIDC trusted publishing\n        run: node js/scripts/setup-npm.mjs\n\n      - name: Version packages and commit to main\n        id: version\n        env:\n          BUMP_TYPE: ${{ inputs.bump_type }}\n          DESCRIPTION: ${{ inputs.description }}\n        run: node js/scripts/version-and-commit.mjs --mode instant\n\n      - name: Publish to npm\n        # Run if version was committed OR if a previous attempt already committed (for re-runs)\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        id: publish\n        run: node js/scripts/publish-to-npm.mjs\n\n      - name: Create GitHub Release\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n          TARGET_COMMITISH: HEAD\n          COMMIT_SHA: HEAD\n        run: node js/scripts/create-github-release.mjs\n\n      - name: Format GitHub release notes\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n          TARGET_COMMITISH: HEAD\n          COMMIT_SHA: HEAD\n        run: node js/scripts/format-github-release.mjs\n\n      - name: Build JS API docs for release\n        if: steps.publish.outputs.published == 'true'\n        run: npm run docs:api\n\n      - name: Setup Rust toolchain for release docs\n        if: steps.publish.outputs.published == 'true'\n        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n\n      - name: Build Rust crate docs for release\n        if: steps.publish.outputs.published == 'true'\n        run: cargo doc --manifest-path rust/Cargo.toml --no-deps --workspace\n\n      - name: Attach API docs to GitHub Release\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_TAG: v${{ steps.publish.outputs.published_version }}\n        run: bash js/scripts/attach-api-docs.sh \"$RELEASE_TAG\"\n\n  # Manual Changeset PR - creates a pull request with the changeset for review\n  changeset-pr:\n    concurrency:\n      group: release-main\n      cancel-in-progress: false\n    name: Create Changeset PR\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changeset-pr'\n    runs-on: ubuntu-24.04\n    # PR creation only — install + format + open PR. 10min is generous.\n    timeout-minutes: 10\n    permissions:\n      contents: write\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Create changeset file\n        env:\n          BUMP_TYPE: ${{ inputs.bump_type }}\n          DESCRIPTION: ${{ inputs.description }}\n        run: node js/scripts/create-manual-changeset.mjs\n\n      - name: Format changeset with Prettier\n        run: |\n          # Run Prettier on the changeset file to ensure it matches project style\n          npx prettier --write \".changeset/*.md\"\n\n          echo \"Formatted changeset files\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1 # v8\n        with:\n          token: ${{ secrets.GITHUB_TOKEN }}\n          commit-message: 'chore: add changeset for manual ${{ github.event.inputs.bump_type }} release'\n          branch: changeset-manual-release-${{ github.run_id }}\n          delete-branch: true\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n          body: |\n            ## Manual Release Request\n\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n\n            ### Release Details\n            - **Type:** ${{ github.event.inputs.bump_type }}\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n            - **Triggered by:** @${{ github.actor }}\n\n            ### Next Steps\n            1. Review the changeset in this PR\n            2. Merge this PR to main\n            3. The automated release workflow will create a version PR\n            4. Merge the version PR to publish to npm and create a GitHub release\n" to contain "PR_AUTHOR: ${{ github.event.pull_request.user.login }}"
