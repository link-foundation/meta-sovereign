    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "lint-staged": "^17.6.0",
    "lottie-web": "5.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "test-anywhere": "^0.9.1"
  },
  "optionalDependencies": {
    "axe-core": "^4.14.0",
    "browser-commander": "^0.32.1",
    "doublets-web": "^0.1.3",
    "playwright": "^1.64.1",
    "telegram": "^2.26.22"
  },
  "peerDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "electron": "^44.9.0",
    "electron-updater": "^6.8.9"
  },
  "peerDependenciesMeta": {
    "@capacitor/android": {
      "optional": true
    },
    "@capacitor/cli": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/ios": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --config js/eslint.config.js --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  }
