{
  "name": "meta-sovereign",
  "version": "0.48.0",
  "description": "Personal meta profile sovereign system - fully local, privacy-respecting personal CRM and unified messenger across services",
  "type": "module",
  "main": "js/src/index.js",
  "types": "js/src/index.d.ts",
  "bin": {
    "meta-sovereign": "js/bin/meta-sovereign.js"
  },
  "exports": {
    ".": {
      "types": "./js/src/index.d.ts",
      "import": "./js/src/index.js"
    },
    "./storage": "./js/src/storage/index.js",
    "./sources": "./js/src/sources/index.js",
    "./sources/email": "./js/src/sources/email.js",
    "./sources/email-node-transport": "./js/src/sources/email-node-transport.js",
    "./sources/auto-import": "./js/src/sources/auto-import/index.js",
    "./sources/vk-auth": "./js/src/sources/vk-auth.js",
    "./patterns": "./js/src/patterns/index.js",
    "./replies": "./js/src/replies/index.js",
    "./automation": "./js/src/automation/index.js",
    "./crm": "./js/src/crm/index.js",
    "./facts": "./js/src/facts/index.js",
    "./sync": "./js/src/sync/index.js",
    "./broadcast": "./js/src/broadcast/index.js",
    "./backup": "./js/src/storage/backup.js",
    "./handlers": "./js/src/handlers/index.js",
    "./cv": "./js/src/cv/index.js",
    "./cv/platforms": "./js/src/cv/platforms/index.js",
    "./cli": "./js/src/cli/index.js",
    "./server": "./js/src/server/index.js"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 js/tests/*.test.js",
    "test:e2e:browser": "node js/tests/e2e-browser-spa.mjs",
    "test:e2e:pages": "node js/tests/e2e-pages.mjs",
    "test:pack": "node js/tests/pack-smoke.mjs",
    "test:e2e:cv": "node js/tests/e2e-cv-browser.mjs",
    "test:e2e:greetings": "node js/tests/e2e-greetings-browser.mjs",
    "test:e2e:tutorial": "node js/tests/e2e-tutorial-browser.mjs",
    "test:e2e:selection": "node js/tests/e2e-chat-selection-browser.mjs",
    "test:e2e:albums": "node js/tests/e2e-albums-browser.mjs",
    "test:e2e:autopilot": "node js/tests/e2e-autopilot-browser.mjs",
    "test:e2e:draft": "node js/tests/e2e-draft-browser.mjs",
    "test:e2e:offline": "node js/tests/e2e-offline-browser.mjs",
    "test:e2e:chat-menu": "node js/tests/e2e-chat-menu-browser.mjs",
    "test:e2e:chat-search": "node js/tests/e2e-chat-search-browser.mjs",
    "test:e2e:attach": "node js/tests/e2e-attach-browser.mjs",
    "test:e2e:format": "node js/tests/e2e-format-browser.mjs",
    "test:e2e:schedule": "node js/tests/e2e-schedule-browser.mjs",
    "test:e2e:folders": "node js/tests/e2e-folders-browser.mjs",
    "test:e2e:emoji": "node js/tests/e2e-emoji-browser.mjs",
    "test:e2e:emoji-tones": "node js/tests/e2e-emoji-tones-browser.mjs",
    "test:e2e:stickers": "node js/tests/e2e-stickers-browser.mjs",
    "test:e2e:jump-date": "node js/tests/e2e-jump-date-browser.mjs",
    "test:e2e:global-search": "node js/tests/e2e-global-search-browser.mjs",
    "test:e2e:voice": "node js/tests/e2e-voice-browser.mjs",
    "test:e2e:reply-return": "node js/tests/e2e-reply-return-browser.mjs",
    "test:e2e:replies": "node js/tests/e2e-reply-cache-browser.mjs",
    "lint": "eslint --config js/eslint.config.js .",
    "lint:fix": "eslint --config js/eslint.config.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "build:web": "node js/scripts/build-web.mjs",
    "build:pages": "node js/scripts/build-pages.mjs",
    "build:mobile": "npm run build:web && node js/scripts/build-mobile.mjs",
    "electron": "npm exec --yes --package electron@^44.9.0 -- electron js/electron/main.js",
    "desktop:prepare": "npm run build:web && node js/scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build:web && node js/scripts/build-desktop.mjs",
    "desktop:icon": "node js/scripts/render-desktop-icon.mjs",
    "mobile:sync": "npm run build:mobile && node js/scripts/mobile-platform.mjs sync",
    "mobile:ios": "npm run build:mobile && node js/scripts/mobile-platform.mjs ios open",
    "mobile:android": "npm run build:mobile && node js/scripts/mobile-platform.mjs android open",
    "docs:api": "node js/scripts/build-api-docs.mjs",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node js/scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "test:e2e:selection:webkit": "E2E_BROWSER=webkit node js/tests/e2e-chat-selection-browser.mjs",
    "test:e2e:albums:webkit": "E2E_BROWSER=webkit node js/tests/e2e-albums-browser.mjs",
    "test:e2e:autopilot:webkit": "E2E_BROWSER=webkit node js/tests/e2e-autopilot-browser.mjs",
    "test:e2e:draft:webkit": "E2E_BROWSER=webkit node js/tests/e2e-draft-browser.mjs",
    "test:e2e:offline:webkit": "E2E_BROWSER=webkit node js/tests/e2e-offline-browser.mjs",
    "test:e2e:chat-menu:webkit": "E2E_BROWSER=webkit node js/tests/e2e-chat-menu-browser.mjs",
    "test:e2e:chat-search:webkit": "E2E_BROWSER=webkit node js/tests/e2e-chat-search-browser.mjs",
    "test:e2e:attach:webkit": "E2E_BROWSER=webkit node js/tests/e2e-attach-browser.mjs",
    "test:e2e:format:webkit": "E2E_BROWSER=webkit node js/tests/e2e-format-browser.mjs",
    "test:e2e:schedule:webkit": "E2E_BROWSER=webkit node js/tests/e2e-schedule-browser.mjs",
    "test:e2e:folders:webkit": "E2E_BROWSER=webkit node js/tests/e2e-folders-browser.mjs",
    "test:e2e:emoji:webkit": "E2E_BROWSER=webkit node js/tests/e2e-emoji-browser.mjs",
    "test:e2e:emoji-tones:webkit": "E2E_BROWSER=webkit node js/tests/e2e-emoji-tones-browser.mjs",
    "test:e2e:stickers:webkit": "E2E_BROWSER=webkit node js/tests/e2e-stickers-browser.mjs",
    "test:e2e:jump-date:webkit": "E2E_BROWSER=webkit node js/tests/e2e-jump-date-browser.mjs",
    "test:e2e:global-search:webkit": "E2E_BROWSER=webkit node js/tests/e2e-global-search-browser.mjs",
    "test:e2e:voice:webkit": "E2E_BROWSER=webkit node js/tests/e2e-voice-browser.mjs",
    "test:e2e:reply-return:webkit": "E2E_BROWSER=webkit node js/tests/e2e-reply-return-browser.mjs",
    "test:e2e:bots": "node js/tests/e2e-bots-browser.mjs",
    "test:e2e:bots:webkit": "E2E_BROWSER=webkit node js/tests/e2e-bots-browser.mjs",
    "test:e2e:shared": "node js/tests/e2e-shared-browser.mjs",
    "test:e2e:shared:webkit": "E2E_BROWSER=webkit node js/tests/e2e-shared-browser.mjs",
    "test:e2e:sticker-search": "node js/tests/e2e-sticker-search-browser.mjs",
    "test:e2e:sticker-search:webkit": "E2E_BROWSER=webkit node js/tests/e2e-sticker-search-browser.mjs",
    "test:e2e:lottie": "node js/tests/e2e-lottie-browser.mjs",
    "test:e2e:lottie:webkit": "E2E_BROWSER=webkit node js/tests/e2e-lottie-browser.mjs",
    "test:e2e:sticker-menu": "node js/tests/e2e-sticker-menu-browser.mjs",
    "test:e2e:sticker-menu:webkit": "E2E_BROWSER=webkit node js/tests/e2e-sticker-menu-browser.mjs",
    "test:e2e:emoji-keywords": "node js/tests/e2e-emoji-keywords-browser.mjs",
    "test:e2e:emoji-keywords:webkit": "E2E_BROWSER=webkit node js/tests/e2e-emoji-keywords-browser.mjs",
    "test:e2e:custom-emoji": "node js/tests/e2e-custom-emoji-browser.mjs",
    "test:e2e:custom-emoji:webkit": "E2E_BROWSER=webkit node js/tests/e2e-custom-emoji-browser.mjs"
  },
  "keywords": [
    "personal-crm",
    "local-first",
    "privacy",
    "links-notation",
    "doublets",
