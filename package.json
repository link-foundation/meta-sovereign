{
  "name": "meta-sovereign",
  "version": "0.8.0",
  "description": "Personal meta profile sovereign system - fully local, privacy-respecting personal CRM and unified messenger across services",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "meta-sovereign": "bin/meta-sovereign.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./storage": "./src/storage/index.js",
    "./sources": "./src/sources/index.js",
    "./patterns": "./src/patterns/index.js",
    "./replies": "./src/replies/index.js",
    "./automation": "./src/automation/index.js",
    "./crm": "./src/crm/index.js",
    "./facts": "./src/facts/index.js",
    "./sync": "./src/sync/index.js",
    "./broadcast": "./src/broadcast/index.js",
    "./backup": "./src/storage/backup.js",
    "./handlers": "./src/handlers/index.js",
    "./cli": "./src/cli/index.js",
    "./server": "./src/server/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "docs:api": "node scripts/build-api-docs.mjs",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "personal-crm",
    "local-first",
    "privacy",
    "links-notation",
    "doublets",
    "meta-profile",
    "sovereign"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/meta-sovereign"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
