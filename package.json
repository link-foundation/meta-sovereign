{
  "name": "meta-sovereign",
  "version": "0.11.0",
  "description": "Personal meta profile sovereign system - fully local, privacy-respecting personal CRM and unified messenger across services",
  "type": "module",
  "main": "js/src/index.js",
  "types": "js/src/index.d.ts",
  "bin": {
    "meta-sovereign": "js/bin/meta-sovereign.js"
  },
  "exports": {
    ".": {
      "types": "./js/src/index.d.ts",
      "import": "./js/src/index.js"
    },
    "./storage": "./js/src/storage/index.js",
    "./sources": "./js/src/sources/index.js",
    "./patterns": "./js/src/patterns/index.js",
    "./replies": "./js/src/replies/index.js",
    "./automation": "./js/src/automation/index.js",
    "./crm": "./js/src/crm/index.js",
    "./facts": "./js/src/facts/index.js",
    "./sync": "./js/src/sync/index.js",
    "./broadcast": "./js/src/broadcast/index.js",
    "./backup": "./js/src/storage/backup.js",
    "./handlers": "./js/src/handlers/index.js",
    "./cli": "./js/src/cli/index.js",
    "./server": "./js/src/server/index.js"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 js/tests/*.test.js",
    "test:e2e:browser": "node js/tests/e2e-browser-spa.mjs",
    "lint": "eslint --config js/eslint.config.js .",
    "lint:fix": "eslint --config js/eslint.config.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "build:web": "node js/scripts/build-web.mjs",
    "build:pages": "node js/scripts/build-pages.mjs",
    "build:mobile": "npm run build:web && node js/scripts/build-mobile.mjs",
    "electron": "npm exec --yes --package electron@^41.5.0 -- electron js/electron/main.js",
    "mobile:sync": "npm run build:mobile && node js/scripts/mobile-platform.mjs sync",
    "mobile:ios": "npm run build:mobile && node js/scripts/mobile-platform.mjs ios open",
    "mobile:android": "npm run build:mobile && node js/scripts/mobile-platform.mjs android open",
    "docs:api": "node js/scripts/build-api-docs.mjs",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node js/scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "personal-crm",
    "local-first",
    "privacy",
    "links-notation",
    "doublets",
    "meta-profile",
    "sovereign"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/meta-sovereign"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "esbuild": "^0.28.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "test-anywhere": "^0.8.48"
  },
  "optionalDependencies": {
    "axe-core": "^4.11.4",
    "browser-commander": "^0.8.0",
    "doublets-web": "^0.1.2",
    "playwright": "^1.40.0"
  },
  "peerDependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "@capacitor/ios": "^7.6.2",
    "electron": "^41.5.0",
    "electron-updater": "^6.8.3"
  },
  "peerDependenciesMeta": {
    "@capacitor/android": {
      "optional": true
    },
    "@capacitor/cli": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/ios": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --config js/eslint.config.js --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
