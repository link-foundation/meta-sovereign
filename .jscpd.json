{
  "threshold": 6.5,
  "minTokens": 30,
  "minLines": 5,
  "mode": "weak",
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.min.js",
    "**/coverage/**",
    "**/.changeset/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/docs/case-studies/**",
    "**/reports/**",
    "**/ci-logs/**",
    "**/target/**",
    "**/Cargo.lock"
  ],
  "reporters": ["console", "html"],
  "output": "./reports/jscpd"
}
